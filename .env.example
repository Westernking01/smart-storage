# Placeholders only. Connectivity is disabled until separate development validation approval.
SMART_STORAGE_BACKEND_ENABLED=false
SMART_STORAGE_TRANSFERS_ENABLED=false
# Offline-prepared development Storage integration. Keep false until separately authorized.
SMART_STORAGE_DEV_CLOUD_ENABLED=false
# Must match NEXT_PUBLIC_SUPABASE_URL; never inferred from historical probe targets.
SMART_STORAGE_DEV_CLOUD_PROJECT_REF=
SMART_STORAGE_DEV_CLOUD_BUCKET=
# Server-only random 32-byte lowercase hex key for allocation-bound upload permits.
# Do not expose with NEXT_PUBLIC_. Changing it invalidates outstanding permits.
SMART_STORAGE_DEV_CLOUD_PERMIT_KEY=
# Server-only signed short-lived JWT for a separately provisioned restricted RPC role.
# Never use service_role, postgres, authenticated, or a role with BYPASSRLS.
# Existing ordinary grants do not provide this capability; do not broaden them.
SMART_STORAGE_DEV_CLOUD_RPC_ROLE=
SMART_STORAGE_DEV_CLOUD_RPC_TOKEN=
# Reserved server-only direct publisher input; runtime selection remains unwired.
# No credential here. See supabase/development-cloud/PUBLISHER-ACTIVATION.md.
SMART_STORAGE_DEV_CLOUD_DATABASE_URL=
# Local gateway development only; does not enable production/cloud transfers.
SMART_STORAGE_LOCAL_VOLUME_ENABLED=false
# Prerequisites and restricted local runtime: docs/local-volume-lifecycle.md
# SMART_STORAGE_LOCAL_VOLUME_ROOT=absolute-private-volume-directory
# SMART_STORAGE_LOCAL_VOLUME_ID=stable-volume-uuid
# SMART_STORAGE_LOCAL_DATABASE_URL=postgresql://ss_volume_runtime:PRIVATE@127.0.0.1:5432/smart_storage_gateway_test
SMART_STORAGE_ENV=development
APP_ORIGIN=http://localhost:3000
# Configure a NEW isolated project after approval; the stopped feasibility project is denied.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Optional future trusted worker only; ordinary Phase 2 application operations never use it.
# Server-only. Never add NEXT_PUBLIC_ to this variable or import it into client code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
